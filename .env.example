# Optional — only used to label the bot's owner in .menu/.owner replies.
# You do NOT set your number here anymore: open the web dashboard this bot
# serves (the Railway/Render URL, or http://localhost:3000 locally) and
# request the pairing code from there instead.
OWNER_NUMBER=12136061765

# Command prefix
PREFIX=.

# Server port (most hosting platforms set this automatically)
PORT=3000

# Auto Status View — automatically mark contacts' status updates as seen
AUTO_STATUS_VIEW=true

# Auto Status React — also auto-react to statuses with AUTO_STATUS_EMOJI (off by default)
AUTO_STATUS_REACT=false
AUTO_STATUS_EMOJI=💚
